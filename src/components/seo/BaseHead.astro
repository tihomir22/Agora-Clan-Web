---
import { url } from '../../lib/url.js';
import { SITE } from '../../data/site.js';
import { graph, organizationSchema, websiteSchema } from '../../lib/schema.js';

interface Props {
  title: string;
  description: string;
  /** Título completo sin sufijo de marca (para la home) */
  rawTitle?: boolean;
  image?: string;
  noindex?: boolean;
  /** Nodos JSON-LD adicionales de la página */
  schema?: unknown[];
}

const {
  title,
  description,
  rawTitle = false,
  image = '/img/og/default.png',
  noindex = false,
  schema = [],
} = Astro.props;

// Astro.site cambia según dónde se publique (dominio propio o URL de proyecto de GitHub);
// Astro.url.pathname ya incluye la base, así que la URL canónica sale bien en ambos casos.
const origin = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', origin).toString();
const ogImage = new URL(url(image), origin).toString();
const fullTitle = rawTitle ? title : `${title} · ${SITE.name}`;

const jsonLd = graph([organizationSchema(), websiteSchema(), ...schema]);
---

<meta charset="utf-8" />
<script is:inline>document.documentElement.classList.add('js')</script>
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<!-- Un solo idioma: un hreflang y un x-default, sin duplicados -->
<link rel="alternate" hreflang="es-ES" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<meta name="theme-color" content={SITE.themeColor} />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE.name} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name} — ${title}`} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitterHandle} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Idiomas: listo para es-MX y en cuando toque LATAM -->

<!-- Iconos -->
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="icon" type="image/png" sizes="32x32" href={url('/img/favicon-32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={url('/img/favicon-16.png')} />
<link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
<link rel="apple-touch-icon" sizes="180x180" href={url('/img/apple-touch-icon.png')} />
<link rel="manifest" href={url('/site.webmanifest')} />
<link rel="sitemap" type="application/xml" href={url('/sitemap.xml')} />

<!-- Tipografías: solo los pesos que usamos y sin bloquear el primer pintado.
     Se cargan como "print" y se activan al terminar de descargar; con JS desactivado
     entran por el <noscript>. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Montserrat:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
/>
<link
  rel="stylesheet"
  media="print"
  onload="this.setAttribute('media', 'all')"
  href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Montserrat:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Montserrat:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
  />
</noscript>

<script is:inline set:html={jsonLd} type="application/ld+json" />
