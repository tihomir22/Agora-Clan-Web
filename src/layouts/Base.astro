---
import BaseHead from '../components/seo/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site.js';
import { url } from '../lib/url.js';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  rawTitle?: boolean;
  image?: string;
  noindex?: boolean;
  schema?: unknown[];
}
const { title, description, rawTitle, image, noindex, schema } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      rawTitle={rawTitle}
      image={image}
      noindex={noindex}
      schema={schema}
    />
    <!-- Fases públicas: script clásico para que los inline de las secciones
         puedan consultarlo sin depender del bundle. -->
    <script is:inline src={url('/assets/public-phase.js')}></script>
  </head>
  <body>
    <a
      href="#contenido"
      title="Saltar directamente al contenido principal"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-neon focus:px-4 focus:py-2 focus:font-display focus:text-sm focus:text-ink"
      >Saltar al contenido</a
    >
    <Header />
    <main id="contenido" class="pt-[70px]">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Si en 1,4 s no han arrancado las animaciones, se muestra todo igualmente.
      setTimeout(() => {
        if (!window.__motionListo) document.documentElement.classList.add('sin-motion');
      }, 1400);
    </script>
    <script>
      import { APP, CONFIG_ENDPOINT } from '../data/site.js';

      // Una sola lectura de /api/v1/config por página. Aplica la fase a todo
      // el documento (CTAs, tiendas, bloques de sección) y avisa a las
      // secciones que necesitan algo más que mostrar/ocultar (p. ej. invitar).
      const runtime = (window as Window & {
        AgoraPhase?: {
          configure: (options: { storeLinks: { ios: string; android: string } }) => unknown;
          init: (root: Document, url: string) => Promise<unknown>;
        };
      }).AgoraPhase;
      if (runtime) {
        // Las URLs viven solo en site.js; el runtime solo las publica en `live`.
        runtime.configure({ storeLinks: { ios: APP.ios, android: APP.android } });
        runtime.init(document, CONFIG_ENDPOINT).then((state) => {
          window.dispatchEvent(new CustomEvent('agora:phase', { detail: state }));
        });
      }
    </script>
    <script>
      // GSAP, Lenis y Atropos pesan; se cargan cuando el navegador está libre
      // para no retrasar el primer pintado, sobre todo en móvil.
      const cargarMovimiento = () => import('../lib/motion.js');
      if ('requestIdleCallback' in window) {
        requestIdleCallback(cargarMovimiento, { timeout: 1800 });
      } else {
        setTimeout(cargarMovimiento, 400);
      }
    </script>
  </body>
</html>
