---
import Icon from './Icon.astro';

interface Props {
  label: string;
  class?: string;
  /** En escritorio deja de ser carrusel y las tarjetas ocupan el ancho completo */
  wrap?: boolean;
}
const { label, class: className = '', wrap = false } = Astro.props;
---

<div class={`u-rail relative ${className}`} data-rail>
  <!-- Degradados de borde -->
  <div
    class:list={['pointer-events-none absolute inset-y-0 left-0 z-10 w-10 bg-gradient-to-r from-ink to-transparent opacity-0 transition-opacity duration-300', wrap && 'lg:hidden']}
    data-rail-fade="start"
    aria-hidden="true"
  >
  </div>
  <div
    class:list={['pointer-events-none absolute inset-y-0 right-0 z-10 w-10 bg-gradient-to-l from-ink to-transparent transition-opacity duration-300', wrap && 'lg:hidden']}
    data-rail-fade="end"
    aria-hidden="true"
  >
  </div>

  <ul
    class:list={[
      '-mx-1 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-smooth px-1 pb-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
      wrap && 'lg:flex-wrap lg:overflow-x-visible lg:snap-none',
    ]}
    data-rail-track
    tabindex="0"
    aria-label={label}
  >
    <slot />
  </ul>

  <div class:list={['mt-3 flex justify-start gap-2', wrap && 'lg:hidden']}>
    <button
      type="button"
      class="grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition-all duration-300 hover:border-neon hover:text-neon disabled:opacity-30 disabled:hover:border-line disabled:hover:text-muted"
      data-rail-prev
      aria-label={`Anterior · ${label}`}
    >
      <Icon name="arrow" class="h-4 w-4 rotate-180" />
    </button>
    <button
      type="button"
      class="grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition-all duration-300 hover:border-neon hover:text-neon disabled:opacity-30 disabled:hover:border-line disabled:hover:text-muted"
      data-rail-next
      aria-label={`Siguiente · ${label}`}
    >
      <Icon name="arrow" class="h-4 w-4" />
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('[data-rail-track]');
    const prev = rail.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = rail.querySelector<HTMLButtonElement>('[data-rail-next]');
    const fadeStart = rail.querySelector<HTMLElement>('[data-rail-fade="start"]');
    const fadeEnd = rail.querySelector<HTMLElement>('[data-rail-fade="end"]');
    if (!track) return;

    const step = () => {
      const first = track.querySelector('li');
      return first ? first.offsetWidth + 12 : track.clientWidth * 0.8;
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      const atStart = track.scrollLeft <= 2;
      const atEnd = track.scrollLeft >= max;
      if (prev) prev.disabled = atStart;
      if (next) next.disabled = atEnd;
      fadeStart?.classList.toggle('opacity-0', atStart);
      fadeEnd?.classList.toggle('opacity-0', atEnd);
      const scrollable = track.scrollWidth > track.clientWidth + 4;
      rail.querySelector('[data-rail-prev]')?.parentElement?.classList.toggle('hidden', !scrollable);
    };

    prev?.addEventListener('click', () => track.scrollBy({ left: -step() * 2, behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step() * 2, behavior: 'smooth' }));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>
