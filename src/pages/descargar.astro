---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import PhoneMockup from '../components/ui/PhoneMockup.astro';
import Tilt from '../components/ui/Tilt.astro';
import Preregistro from '../components/sections/Preregistro.astro';
import Icon from '../components/ui/Icon.astro';
import BrandMark from '../components/ui/BrandMark.astro';
import { SOCIAL } from '../data/site.js';
import { appSchema, breadcrumbSchema, faqSchema } from '../lib/schema.js';

import bienvenida from '../assets/app/agora-app-bienvenida.png';
import styxxEstandarte from '../assets/mascotas/styxx-estandarte.png';

const pasos = [
  { n: '01', t: 'Descarga la app', d: 'Cuando esté publicada, desde App Store o Google Play.' },
  { n: '02', t: 'Crea tu cuenta', d: 'Usuario, correo y edad. Un minuto y listo.' },
  { n: '03', t: 'Completa tu perfil', d: 'Elige avatar, marco y los juegos que juegas.' },
  { n: '04', t: 'Entra a competir', d: 'Torneos, retas con amigos y clanes desde el móvil.' },
];

const faqs = [
  {
    q: '¿Cuándo estará disponible Ágora?',
    a: 'Ágora estará disponible para iOS en App Store y para Android en Google Play, con foco inicial en España. En esta misma página verás el estado actualizado de cada tienda y, cuando la app esté publicada, el enlace de descarga.',
  },
  {
    q: '¿Cuánto cuesta?',
    a: 'Descargar y competir es libre. Hay cosméticos opcionales y una suscripción de comodidad, pero nada de eso da ventaja competitiva.',
  },
  {
    q: '¿Puedo jugar desde el ordenador?',
    a: 'La app es para iOS y Android. Los juegos de PC como Valorant o League of Legends se vinculan y se compite en ellos, coordinando la partida desde el móvil.',
  },
];
---

<Base
  title="Descargar Ágora — iOS y Android"
  description="Ágora se publica en App Store y Google Play. Consulta el estado del pre-registro y de la descarga, y cómo entrar a jugar y organizar torneos desde el móvil."
  schema={[
    appSchema(),
    breadcrumbSchema([
      { label: 'Inicio', href: '/' },
      { label: 'Descargar', href: '/descargar' },
    ]),
    faqSchema(faqs),
  ]}
>
  <section class="u-shell grid gap-14 pt-16 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:pt-24">
    <div>
      <!-- El estado se resuelve en runtime con /api/v1/config. Sin datos no
           se afirma ni apertura del pre-registro ni disponibilidad. -->
      <div data-phase="live" hidden>
        <div
          class="inline-flex items-center gap-2 rounded-full border border-neon/30 bg-neon/10 px-3.5 py-1.5"
          data-reveal
        >
          <Icon name="check" class="h-3.5 w-3.5 text-neon" />
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-neon">Ya disponible</span>
        </div>
      </div>
      <div data-phase="preregister" hidden>
        <div
          class="inline-flex items-center gap-2 rounded-full border border-neon/30 bg-neon/10 px-3.5 py-1.5"
          data-reveal
        >
          <Icon name="clock" class="h-3.5 w-3.5 text-neon" />
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-neon">Pre-registro abierto</span>
        </div>
      </div>
      <div data-phase="upcoming" hidden>
        <div
          class="inline-flex items-center gap-2 rounded-full border border-gold/30 bg-gold/10 px-3.5 py-1.5"
          data-reveal
        >
          <Icon name="clock" class="h-3.5 w-3.5 text-gold" />
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-gold">Próximamente</span>
        </div>
      </div>
      <div data-phase="unknown">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/60 px-3.5 py-1.5"
          data-reveal
        >
          <Icon name="clock" class="h-3.5 w-3.5 text-muted" />
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-muted">Estado de la app</span>
        </div>
      </div>

      <h1 class="mt-6 text-hero font-black uppercase">
        Descarga<br /><span class="text-neon">Ágora</span>
      </h1>
      <p class="mt-5 max-w-lg text-[0.95rem] leading-relaxed text-muted sm:mt-6 sm:text-[1.05rem]" data-reveal data-reveal-delay="0.1" data-phase="live" hidden>
        Ágora ya está en App Store y Google Play. Descárgala y entra a competir.
      </p>
      <p class="mt-5 max-w-lg text-[0.95rem] leading-relaxed text-muted sm:mt-6 sm:text-[1.05rem]" data-reveal data-reveal-delay="0.1" data-phase="preregister" hidden>
        La app todavía no está publicada en las tiendas, pero el pre-registro con recompensas de
        fundador sigue abierto: reserva tu plaza y te avisamos el día del lanzamiento.
      </p>
      <p class="mt-5 max-w-lg text-[0.95rem] leading-relaxed text-muted sm:mt-6 sm:text-[1.05rem]" data-reveal data-reveal-delay="0.1" data-phase="upcoming" hidden>
        La app estará disponible para iOS en App Store y para Android en Google Play. El pre-registro con recompensas de
        fundador ha cerrado; aquí publicaremos el enlace de descarga de cada tienda en cuanto esté disponible.
      </p>
      <p class="mt-5 max-w-lg text-[0.95rem] leading-relaxed text-muted sm:mt-6 sm:text-[1.05rem]" data-reveal data-reveal-delay="0.1" data-phase="unknown" data-phase-status>
        Comprobando el estado del pre-registro y de las tiendas…
      </p>

      <!-- Botones de tienda -->
      <div class="mt-8 flex flex-wrap gap-3" data-reveal data-reveal-delay="0.15">
        {
          [
            { key: 'ios', store: 'App Store', mark: 'appstore', sub: 'iOS' },
            { key: 'android', store: 'Google Play', mark: 'googleplay', sub: 'Android' },
          ].map((s) => (
            <div>
              <a
                data-store-link={s.key}
                hidden
                target="_blank"
                rel="noopener"
                class="group inline-flex items-center gap-3 rounded-lg border border-neon bg-neon px-5 py-3.5 text-ink transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_32px_-6px_rgb(10_255_122/0.7)]"
                title={`Descargar Ágora en ${s.store}`}
              >
                <BrandMark mark={s.mark} class="h-7 w-7" title={s.store} />
                <span class="text-left">
                  <span class="block font-mono text-[0.55rem] uppercase tracking-[0.16em] opacity-70">
                    Descargar en
                  </span>
                  <span class="block font-display text-[0.86rem] font-black uppercase tracking-wide">
                    {s.store}
                  </span>
                </span>
              </a>
              <span
                data-store-pending
                hidden
                class="group inline-flex cursor-default items-center gap-3 rounded-lg border border-line bg-surface/40 px-5 py-3.5 transition-colors duration-500 hover:border-gold/45"
                aria-disabled="true"
              >
                <BrandMark
                  mark={s.mark}
                  class="h-7 w-7 text-muted transition-colors duration-500 group-hover:text-gold"
                  title={s.store}
                />
                <span class="text-left">
                  <span class="block font-display text-[0.82rem] font-bold uppercase tracking-wide">
                    {s.store}
                  </span>
                  <span class="block font-mono text-[0.55rem] uppercase tracking-[0.16em] text-gold">
                    Muy pronto · {s.sub}
                  </span>
                </span>
              </span>
            </div>
          ))
        }
      </div>

      <a href="#pre-registro" data-phase="preregister" hidden title="Reserva tu plaza en el pre-registro de Ágora" class="u-btn u-btn--primary mt-6 hidden sm:inline-flex" data-reveal>
        Reserva tu plaza
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>

    <div class="relative mx-auto w-full max-w-[420px]" data-reveal data-reveal-delay="0.08">
      <Tilt class="w-full" rotate={9}>
        <div class="relative pb-4">
          <PhoneMockup
            src={bienvenida}
            alt="Pantalla de bienvenida de Ágora en el móvil"
            width={340}
            class="w-[68%]"
            offset={2}
            priority
          />
          <Image
            src={styxxEstandarte}
            alt="Styxx, la mascota de Ágora, sosteniendo el estandarte"
            width={440}
            densities={[1, 2]}
            class="pointer-events-none absolute bottom-0 right-0 z-10 w-[44%] max-w-[190px] drop-shadow-[0_22px_44px_rgb(0_0_0/0.75)]"
            data-float="8"
            data-atropos-offset="-6"
          />
        </div>
      </Tilt>
    </div>
  </section>

  <Preregistro id="pre-registro" compact />

  <!-- PASOS -->
  <Section eyebrow="Cómo funciona" title="De aquí a la arena">
    <div class="mt-10 grid gap-3 sm:mt-12 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4" data-reveal-group>
      {
        pasos.map((p) => (
          <article class="u-card p-5 sm:p-6" data-reveal-item>
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.24em] text-neon">{p.n}</p>
            <h3 class="mt-3 font-display text-[0.85rem] font-bold uppercase tracking-wide">{p.t}</h3>
            <p class="mt-2.5 text-[0.84rem] text-muted">{p.d}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col items-center gap-6 rounded-xl border border-line bg-surface/30 p-6 sm:p-7 sm:flex-row" data-reveal>
      <div class="flex-1 text-center sm:text-left">
        <h3 class="font-display text-[0.95rem] font-black uppercase tracking-wide">
          Mientras tanto, sígueme la pista
        </h3>
        <p class="mt-2 text-sm text-muted">
          Publicamos avances, torneos y llamadas a clanes casi a diario.
        </p>
      </div>
      <ul class="flex gap-2.5">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" title={s.title} class="u-btn u-btn--ghost !px-4 !py-2.5 !text-[0.66rem]">
                <BrandMark mark={s.name.toLowerCase()} class="h-3.5 w-3.5" />
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</Base>
