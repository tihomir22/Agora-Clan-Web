---
import { url } from '../lib/url.js';
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import { Image } from 'astro:assets';
import ladon from '../assets/mascotas/ladon-lupa.png';
---

<Base
  title="Página no encontrada"
  description="Esta página no existe en Ágora."
  noindex
>
  <section class="u-shell grid min-h-[70vh] place-items-center py-24 text-center">
    <div>
      <Image src={ladon} alt="Ladón, mascota de Ágora, buscando con una lupa" width={340} densities={[1, 2]} class="mx-auto h-40 w-auto object-contain" />
      <p class="u-eyebrow mt-8">Error 404</p>
      <h1 class="mt-5 text-display">Aquí no hay partida</h1>
      <p class="mx-auto mt-5 max-w-md text-muted">
        Ladón ha buscado por todas partes y esta página no aparece. Vuelve a la arena.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={url('/')} title="Ágora: encuentra jugadores y organiza torneos" class="u-btn u-btn--primary">Volver al inicio<Icon name="arrow" class="h-4 w-4" /></a>
        <a href={url('/torneos')} title="Torneos, duelos y batallas: cómo se compite en Ágora" class="u-btn u-btn--ghost">Ver torneos</a>
      </div>
    </div>
  </section>

  <!-- GitHub Pages no tiene rewrites: los deep links caen aquí y se llevan al
       artefacto estático correspondiente, conservando query string y hash. -->
  <script is:inline define:vars={{ base: url('/'), referralArtifact: url('/r.html'), tournamentArtifact: url('/t.html') }}>
    (() => {
      const basePath = new URL(base, location.origin).pathname.replace(/\/$/, '');
      const pathname = location.pathname;
      const route = basePath && pathname.startsWith(basePath) ? pathname.slice(basePath.length) : pathname;
      const match = route.match(/^\/(r|t)\/([^/?#]+)\/?$/);
      if (!match) return;

      const params = new URLSearchParams(location.search);
      const parameter = match[1] === 'r' ? 'ref' : 'token';
      if (!params.has(parameter)) params.set(parameter, match[2]);

      const destination = match[1] === 'r' ? referralArtifact : tournamentArtifact;
      const query = params.toString();
      location.replace(destination + (query ? '?' + query : '') + location.hash);
    })();
  </script>
</Base>
