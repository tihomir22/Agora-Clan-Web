---
import { NAV, SOCIAL, LEGAL, SITE } from '../data/site.js';
import { url } from '../lib/url.js';
import Logo from './ui/Logo.astro';
import BrandMark from './ui/BrandMark.astro';
const year = new Date().getFullYear();
---

<footer class="mt-[var(--spacing-section)] border-t border-line">
  <div class="u-shell py-14">
    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <Logo class="h-9 w-auto" width={280} />
        <p class="mt-5 max-w-xs text-sm text-muted">
          La arena digital donde cualquiera puede competir. Sin equipo, sin contactos y sin
          depender de nadie.
        </p>
        <p class="mt-5 font-mono text-[0.66rem] uppercase tracking-[0.2em] text-neon">
          Los juegos no cambiaron. Nosotros sí.
        </p>
      </div>

      <div>
        <p class="u-eyebrow !text-muted">Navegación</p>
        <ul class="mt-4 space-y-2.5">
          {
            NAV.map((l) => (
              <li>
                <a href={url(l.href)} title={l.title} class="text-sm text-muted transition-colors hover:text-neon">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="u-eyebrow !text-muted">Síguenos</p>
        <ul class="mt-4 space-y-2.5">
          {
            SOCIAL.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="me noopener"
                  title={s.title}
                  class="group inline-flex items-center gap-2.5 text-sm text-muted transition-colors hover:text-neon"
                >
                  <BrandMark
                    mark={s.name.toLowerCase()}
                    class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110"
                  />
                  {s.name}
                  <span class="font-mono text-[0.66rem] text-line">{s.handle}</span>
                </a>
              </li>
            ))
          }
          <li class="pt-2">
            <a
              href={url('/soporte')}
              title="Soporte de Ágora"
              class="text-sm text-muted transition-colors hover:text-neon">Soporte</a
            >
            <p class="mt-1 font-mono text-[0.66rem] text-line">agoragaming99@gmail.com</p>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-line pt-6 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.name}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          LEGAL.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener" title={l.title} class="transition-colors hover:text-neon">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
