---
import { Image } from 'astro:assets';
import { url } from '../lib/url.js';
import Icon from './ui/Icon.astro';
import styxxEstandarte from '../assets/mascotas/styxx-estandarte.png';

interface Props {
  kind: 'referral' | 'tournament';
}

const { kind } = Astro.props;
const isReferral = kind === 'referral';
const label = isReferral ? 'Invitación' : 'Torneo';
const title = isReferral ? 'Te han invitado a Ágora' : 'Te han invitado a un torneo';
const description = isReferral
  ? 'Continúa en Ágora para unirte a la comunidad que te ha invitado y empezar a competir.'
  : 'Continúa en Ágora para entrar al torneo y competir con el resto de participantes.';
const defaultDestination = isReferral
  ? 'https://app.agoraclan.com/signup'
  : 'https://app.agoraclan.com/landing/searchTournaments/tournament';
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 opacity-35 [background-image:linear-gradient(rgb(10_255_122/0.05)_1px,transparent_1px),linear-gradient(90deg,rgb(10_255_122/0.05)_1px,transparent_1px)] [background-size:46px_46px] [mask-image:radial-gradient(ellipse_70%_65%_at_65%_0%,black,transparent)]"
    aria-hidden="true"
  ></div>

  <div class="u-shell relative grid min-h-[calc(100vh-70px)] gap-12 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:py-24">
    <div data-reveal>
      <p class="u-eyebrow">{label}</p>
      <h1 class="mt-6 max-w-3xl text-display font-black uppercase">{title}</h1>
      <p class="mt-6 max-w-xl text-[0.98rem] leading-relaxed text-muted sm:text-[1.08rem]">{description}</p>

      <div class="mt-8 flex flex-wrap gap-3" data-reveal data-reveal-delay="0.12">
        <a
          href={defaultDestination}
          target="_blank"
          rel="noopener"
          data-app-link
          class="u-btn u-btn--primary"
          title="Continuar en la web de Ágora"
        >
          Continuar en la web
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href={url('/descargar')} class="u-btn u-btn--ghost" title="Descargar Ágora">
          Descargar Ágora
          <Icon name="download" class="h-4 w-4" />
        </a>
        <a
          data-store-link="ios"
          hidden
          target="_blank"
          rel="noopener"
          class="u-btn u-btn--ghost"
          title="Descargar Ágora en App Store"
        >
          App Store
        </a>
        <a
          data-store-link="android"
          hidden
          target="_blank"
          rel="noopener"
          class="u-btn u-btn--ghost"
          title="Descargar Ágora en Google Play"
        >
          Google Play
        </a>
      </div>

      <p class="mt-5 min-h-6 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-muted" data-value aria-live="polite">
      </p>
      <p class="mt-3 max-w-lg text-[0.78rem] leading-relaxed text-muted/80">
        <span data-phase="live" hidden>Ya disponible en App Store y Google Play.</span>
        <span data-phase="upcoming" hidden>La descarga todavía no está abierta; consulta la página de descarga para ver el estado.</span>
        <span data-phase="unknown">Comprobando la disponibilidad de la app…</span>
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-[390px]" data-reveal data-reveal-delay="0.08" aria-hidden="true">
      <div class="absolute inset-10 rounded-full bg-neon/10 blur-3xl"></div>
      <Image
        src={styxxEstandarte}
        alt="Styxx, la mascota de Ágora, sosteniendo el estandarte"
        width={440}
        densities={[1, 2]}
        class="relative z-10 mx-auto w-[78%] drop-shadow-[0_22px_44px_rgb(0_0_0/0.75)]"
        data-float="8"
        data-atropos-offset="-6"
      />
    </div>
  </div>
</section>

<script is:inline define:vars={{ mode: kind, siteBase: url('/') }}>
  (() => {
    const referralPattern = /^[A-Za-z0-9_-]{3,16}$/;
    const uuidPattern = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
    const tokenPattern = /^[A-Za-z0-9_-]{3,64}$/;
    const isReferral = mode === 'referral';
    const route = isReferral ? 'r' : 't';
    const queryKey = isReferral ? 'ref' : 'token';
    const storageKey = isReferral ? 'agora_ref_code' : 'agora_tournament_token';
    const pathname = window.location.pathname;
    const basePath = new URL(siteBase, window.location.origin).pathname.replace(/\/$/, '');
    const relativePath = basePath && pathname.startsWith(basePath) ? pathname.slice(basePath.length) : pathname;
    const segments = relativePath.split('/').filter(Boolean);
    const pathValue = segments[0] === route ? segments[1] || '' : '';
    const queryValue = new URLSearchParams(window.location.search).get(queryKey) || '';
    const value = pathValue || queryValue;
    const valid = isReferral
      ? referralPattern.test(value)
      : uuidPattern.test(value) || tokenPattern.test(value);
    const appLink = document.querySelector('[data-app-link]');
    const status = document.querySelector('[data-value]');

    if (!valid) {
      if (status) status.textContent = 'Enlace no válido o caducado';
      return;
    }

    try {
      localStorage.setItem(storageKey, value);
    } catch {
      // El modo privado puede bloquear localStorage; el enlace sigue funcionando.
    }

    if (appLink) {
      appLink.href = isReferral
        ? 'https://app.agoraclan.com/signup?ref=' + encodeURIComponent(value)
        : 'https://app.agoraclan.com/landing/searchTournaments/tournament/' + encodeURIComponent(value);
    }
    if (status) status.textContent = (isReferral ? 'Código: ' : 'Torneo: ') + value;
  })();
</script>
