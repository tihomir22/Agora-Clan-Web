---
import { url } from '../lib/url.js';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import PhoneMockup from '../components/ui/PhoneMockup.astro';
import Rail from '../components/ui/Rail.astro';
import Tilt from '../components/ui/Tilt.astro';
import AppShowcase from '../components/sections/AppShowcase.astro';
import Recompensas from '../components/sections/Recompensas.astro';
import Preregistro from '../components/sections/Preregistro.astro';
import Icon from '../components/ui/Icon.astro';
import { appSchema } from '../lib/schema.js';
import { LANZAMIENTO } from '../data/juegos.js';

import misionesRacha from '../assets/app/agora-app-misiones-racha.png';
import perfilJugador from '../assets/app/agora-app-perfil-jugador.png';
import juegosVinculados from '../assets/app/agora-app-juegos-vinculados.png';




import brawl from '../assets/juegos/brawl-stars.jpg';
import clash from '../assets/juegos/clash-royale.png';
import valorant from '../assets/juegos/valorant.jpg';
import lol from '../assets/juegos/league-of-legends.jpg';

const covers: Record<string, ImageMetadata> = {
  'brawl-stars': brawl,
  'clash-royale': clash,
  valorant,
  'league-of-legends': lol,
};

const ciclo = [
  {
    n: '01',
    verb: 'Encontrar',
    title: 'Deja de jugar con desconocidos',
    body: 'Encuentra jugadores en Busco grupo filtrando por juego, idioma y horario, y monta el equipo que llevas meses buscando.',
  },
  {
    n: '02',
    verb: 'Competir',
    title: 'Organiza tu torneo en dos minutos',
    body: 'Juega duelos, batallas rápidas o torneos por brackets. Ágora coordina la partida, recoge los dos reportes y cierra el marcador solo.',
  },
  {
    n: '03',
    verb: 'Progresar',
    title: 'Que se note lo que has jugado',
    body: 'Nivel, XP, emblemas, títulos y marcos. Un historial que es tuyo y que atraviesa todos los juegos que vincules.',
  },
];




---

<Base
  title="Ágora — Encuentra jugadores y organiza torneos"
  description="La app gamer para encontrar jugadores, jugar y organizar torneos con brackets, crear tu clan y subir de nivel con un perfil propio. Para iOS y Android."
  rawTitle
  schema={[appSchema()]}
>
  <!-- ══════════ HERO ══════════ -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-40 [background-image:linear-gradient(rgb(10_255_122/0.05)_1px,transparent_1px),linear-gradient(90deg,rgb(10_255_122/0.05)_1px,transparent_1px)] [background-size:46px_46px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"
      aria-hidden="true"
    >
    </div>

    <div class="u-shell relative grid gap-10 pb-[var(--spacing-section)] pt-12 sm:pt-16 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-10 lg:pt-20">
      <div>
        <p class="u-eyebrow" data-reveal>iOS y Android</p>

        <h1 class="mt-6 text-hero font-black uppercase">
          Encuentra jugadores <br />y organiza <br />
          <span
            class="bg-[linear-gradient(110deg,#0AFF7A,#47F59A,#0AFF7A)] bg-[length:220%_100%] bg-clip-text text-transparent [animation:heroFlow_6s_linear_infinite]"
            >tus torneos</span
          >
        </h1>

        <p class="mt-6 max-w-md text-[0.95rem] leading-relaxed text-muted sm:mt-7 sm:max-w-lg sm:text-[1.06rem]">
          Ágora es la arena digital para gamers: encuentra con quién jugar, crea tu clan, compite en
          torneos y construye un perfil que demuestra todo lo que has conseguido.
        </p>
        <p class="mt-3 max-w-md text-[0.9rem] leading-relaxed text-bone sm:max-w-lg sm:text-[1rem]">
          Comunidad, competición y progresión en un solo lugar.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-2.5 sm:mt-8 sm:gap-3" data-reveal data-reveal-delay="0.18">
          <a
            href={url('/descargar')}
            class="u-btn u-btn--primary max-w-full"
            title="Cómo entrar en Ágora"
          >
            Únete y empieza a competir
            <Icon name="arrow" class="hidden h-4 w-4 sm:block" />
          </a>
          <a
            href={url('/torneos')}
            class="u-btn u-btn--ghost"
            title="Cómo funcionan los torneos y los duelos en Ágora"
            >Conoce la arena</a
          >
                </div>

        <dl class="mt-10 grid max-w-lg grid-cols-3 sm:mt-12 gap-px overflow-hidden rounded-xl border border-line bg-line" data-reveal-group>
          {
            [
              { k: 'Encuentra', v: 'Jugadores y equipo para tus juegos' },
              { k: 'Compite', v: 'Duelos, batallas y torneos propios' },
              { k: 'Progresa', v: 'XP, ranking, emblemas e identidad' },
            ].map((s) => (
              <div class="flex h-full flex-col items-center justify-start bg-ink px-3 py-4 text-center sm:px-4 sm:py-5" data-reveal-item>
                <dt class="font-mono text-[0.56rem] uppercase tracking-[0.18em] text-neon sm:text-[0.6rem]">
                  {s.k}
                </dt>
                <dd class="mt-2 text-[0.72rem] leading-snug text-muted sm:text-[0.8rem]">{s.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Abanico de tres pantallas: preview rápido sin ocupar media página -->
      <div class="relative mx-auto w-full max-w-[400px]" data-reveal data-reveal-delay="0.1">
        <Tilt class="w-full" rotate={9}>
          <div class="flex items-end justify-center">
            <PhoneMockup
              src={misionesRacha}
              alt="Misiones diarias y racha en la app de Ágora"
              width={210}
              class="w-[36%] -mr-[7%] -rotate-[7deg] translate-y-7"
              float={9}
              offset={-5}
              glow={false}
            />
            <PhoneMockup
              src={perfilJugador}
              alt="Perfil de jugador de Ágora con marco, título y emblemas"
              width={260}
              class="relative z-10 w-[42%]"
              offset={4}
              priority
            />
            <PhoneMockup
              src={juegosVinculados}
              alt="Juegos favoritos y estadísticas verificadas en la app de Ágora"
              width={210}
              class="w-[36%] -ml-[7%] rotate-[7deg] translate-y-7"
              float={13}
              offset={-5}
              glow={false}
            />
          </div>
        </Tilt>
      </div>
    </div>

    <!-- Cinta -->
    <div class="relative border-y border-line bg-surface/40 py-3.5" aria-hidden="true">
      <div class="flex gap-10 whitespace-nowrap [animation:marquee_28s_linear_infinite]">
        {
          Array.from({ length: 4 }).map(() => (
            <div class="flex shrink-0 gap-10 font-mono text-[0.66rem] uppercase tracking-[0.24em] text-muted">
              <span>Los juegos no cambiaron</span>
              <span class="text-neon">·</span>
              <span>Nosotros sí</span>
              <span class="text-neon">·</span>
              <span>Cero pay-to-win</span>
              <span class="text-neon">·</span>
              <span>Habilidad pura</span>
              <span class="text-neon">·</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══════════ CICLO (carrusel) ══════════ -->
  <Section
    id="arena"
    eyebrow="Cómo funciona"
    title="Encontrar, competir, progresar"
    intro="Encontrar jugadores, jugar y organizar torneos: todo el ciclo dentro de la misma app. Sin hojas de cálculo, sin bracket en otra web, sin alguien haciendo de árbitro a mano."
  >
    <Rail label="Cómo funciona Ágora" class="mt-12" wrap>
      {
        ciclo.map((step) => (
          <li class="u-card group w-[236px] shrink-0 snap-start p-5 sm:p-6 sm:w-[300px] lg:w-[calc((100%-1.5rem)/3)]">
            <div class="flex items-baseline gap-3">
              <span class="font-display text-2xl font-black text-neon/30 transition-colors duration-500 group-hover:text-neon/70">
                {step.n}
              </span>
              <p class="font-mono text-[0.62rem] uppercase tracking-[0.24em] text-neon">{step.verb}</p>
            </div>
            <h3 class="mt-3.5 font-display text-[0.9rem] font-black uppercase leading-tight sm:text-[0.98rem]">
              {step.title}
            </h3>
            <p class="mt-2.5 text-[0.82rem] leading-relaxed text-muted sm:text-[0.88rem]">{step.body}</p>
          </li>
        ))
      }
    </Rail>

    <div class="mt-8 flex flex-wrap gap-3" data-reveal>
      <a href={url('/torneos')} title="Torneos, duelos y batallas: cómo se compite en Ágora" class="u-btn u-btn--primary">
        Cómo funcionan los torneos
        <Icon name="arrow" class="h-4 w-4" />
      </a>
      <a href={url('/torneos#comunidad')} title="Trae tu comunidad a Ágora: clan ampliado gratis" class="u-btn u-btn--ghost">Tengo una comunidad</a>
    </div>
  </Section>

  <!-- ══════════ EXPLORADOR DE PANTALLAS ══════════ -->
  <AppShowcase />

  <!-- ══════════ CLANES Y COMUNIDAD ══════════ -->
  <Section eyebrow="Clanes" title="Crea tu clan y trae a los tuyos" intro="Monta tu clan con escudo por capas, reparte roles y organiza torneos entre clanes. Ganar sube a tu equipo en la clasificación global.">
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        [
          { i: 'shield', t: 'Escudo por capas' },
          { i: 'users', t: 'Roles y miembros' },
          { i: 'star', t: 'Elo y leaderboard' },
          { i: 'bracket', t: 'Torneos de clan' },
        ].map((c) => (
          <div class="flex items-center gap-3 rounded-lg border border-line px-3.5 py-3 sm:px-4 sm:py-3.5" data-reveal-item>
            <Icon name={c.i} class="h-4 w-4 shrink-0 text-neon" />
            <span class="text-[0.8rem] sm:text-[0.86rem]">{c.t}</span>
          </div>
        ))
      }
    </div>

    <div
      class="mt-8 flex flex-col gap-5 rounded-xl border border-neon/25 bg-neon/[0.04] p-5 sm:p-7 sm:flex-row sm:items-center sm:justify-between"
      data-reveal
    >
      <p class="max-w-xl text-[0.95rem] text-muted">
        <strong class="text-bone">¿Ya tienes comunidad?</strong> Llega con tu clan, tu servidor o tu
        audiencia y te damos un clan gratuito con un límite de miembros mucho más amplio, más
        recompensas para todos los que entren contigo.
      </p>
      <a href={url('/comunidad')} title="Rellena la solicitud para traer tu comunidad a Ágora" class="u-btn u-btn--primary shrink-0">
        Traigo mi comunidad
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </Section>

  <!-- ══════════ JUEGOS ══════════ -->
  <Section
    eyebrow="Catálogo"
    title="Juegos en el lanzamiento"
    intro="Cuatro títulos de comunidad enorme, dos de móvil y dos de PC. El catálogo rota cada temporada y puedes crear tus torneos en cualquier juego que esté en la wiki de Ágora."
  >
    <div class="mx-auto mt-10 grid max-w-[22rem] grid-cols-2 gap-3 sm:max-w-none sm:gap-4 sm:mt-12 lg:grid-cols-4" data-reveal-group>
      {
        LANZAMIENTO.map((g) => (
          <a href={url('/juegos')} title="Catálogo de juegos para competir en Ágora" class="group block" data-reveal-item>
            <div class="relative overflow-hidden rounded-xl border border-line transition-all duration-500 group-hover:-translate-y-1.5 group-hover:border-neon/50">
              <Image
                src={covers[g.slug]}
                alt={`${g.name}, uno de los juegos disponibles en Ágora en el lanzamiento`}
                width={360}
                densities={[1, 2]}
                class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-ink via-ink/25 to-transparent opacity-80 transition-opacity duration-500 group-hover:opacity-95"
                aria-hidden="true"
              />
              <div class="absolute inset-x-0 bottom-0 p-3.5">
                <p class="font-display text-[0.7rem] font-black uppercase leading-tight sm:text-[0.78rem]">{g.name}</p>
                <p class="mt-1 font-mono text-[0.55rem] uppercase tracking-[0.16em]" style={`color:${g.color}`}>
                  {g.platform}
                </p>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-10" data-reveal>
      <a href={url('/juegos')} title="Catálogo de juegos para competir en Ágora" class="u-btn u-btn--ghost">
        Ver el catálogo completo
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </Section>

  <!-- ══════════ PRE-REGISTRO ══════════ -->
  <Preregistro />

  <!-- ══════════ RECOMPENSAS ══════════ -->
  <Recompensas />

</Base>

<style>
  @keyframes heroFlow {
    to {
      background-position: 220% 0;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
